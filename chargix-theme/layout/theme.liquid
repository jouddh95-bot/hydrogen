<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_ink }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Instrument+Serif:ital@0;1&family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap">

    {%- render 'theme-tokens' -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'luxe.css' | asset_url | stylesheet_tag }}
    {%- if settings.page_transitions -%}
      <style>@view-transition { navigation: auto; }</style>
    {%- endif -%}

    <script type="importmap">
      { "imports": { "three": "{{ 'three.module.min.js' | asset_url }}" } }
    </script>
    <script>
      document.documentElement.classList.replace('no-js', 'js');
      if ('onpagereveal' in window && {{ settings.page_transitions | json }}) document.documentElement.classList.add('vt');
      /* Arriving from another ChargiX page: start the reveal from where the
         visitor clicked. First visit of the session: play the charging intro. */
      (function (html) {
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        try {
          var nav = JSON.parse(sessionStorage.getItem('chargix:nav') || 'null');
          sessionStorage.removeItem('chargix:nav');
          if (nav && Date.now() - nav.t < 6000 && !reduced) {
            html.style.setProperty('--warp-x', nav.x + 'px');
            html.style.setProperty('--warp-y', nav.y + 'px');
            html.classList.add('is-arriving');
            if (nav.dir) html.classList.add('dir-' + nav.dir);
          } else if ({{ settings.intro_loader | json }} && !reduced && !sessionStorage.getItem('chargix:intro')) {
            html.classList.add('has-intro');
          }
          sessionStorage.setItem('chargix:intro', '1');
        } catch (e) {}
      })(document.documentElement);
      window.Chargix = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }}
        },
        moneyFormat: {{ shop.money_format | json }},
        reducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)').matches
      };
    </script>
    <script src="{{ 'motion.js' | asset_url }}" defer></script>
    <script src="{{ 'cart.js' | asset_url }}" defer></script>
    {%- if settings.smooth_scroll -%}
      <script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
    {%- endif -%}
    <script src="{{ 'luxe.js' | asset_url }}" defer></script>
    {%- if settings.ambient_circuit -%}
      <script src="{{ 'ambient.js' | asset_url }}" defer></script>
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}" data-transitions="{{ settings.page_transitions }}" data-cursor="{{ settings.cursor_glow }}" data-smooth="{{ settings.smooth_scroll }}">
    {% render 'ambient' %}
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    <div class="charge-bar" aria-hidden="true"><span></span></div>

    {% sections 'header-group' %}

    <main id="MainContent" class="page" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}

    <div class="cursor-glow" aria-hidden="true"></div>
  </body>
</html>
