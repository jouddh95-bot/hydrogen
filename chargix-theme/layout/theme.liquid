<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_ink }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;500;600;700;800;900&family=Inter+Tight:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Space+Mono:wght@400;700&display=swap">

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'feed.css' | asset_url | stylesheet_tag }}
    {%- render 'theme-tokens' -%}

    <script type="importmap">
      { "imports": { "three": "{{ 'three.module.min.js' | asset_url }}" } }
    </script>
    <script>
      document.documentElement.classList.replace('no-js', 'js');
      /* Arriving from another ChargiX page: the coloured cover that swiped in
         on the last page is still on screen at first paint, then slides away
         (motion.js). Bounded so a slow or failed script never leaves it up. */
      (function (html) {
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        try {
          var nav = JSON.parse(sessionStorage.getItem('chargix:nav') || 'null');
          sessionStorage.removeItem('chargix:nav');
          if (nav && Date.now() - nav.t < 8000 && !reduced && {{ settings.page_transitions | json }}) {
            html.classList.add('is-arriving');
            if (nav.dir) html.classList.add('dir-' + nav.dir);
            if (nav.color) html.style.setProperty('--cover', nav.color);
            window.__cxNav = nav;
            setTimeout(function () { html.classList.add('is-revealed'); }, 2500);
          }
        } catch (e) {}
      })(document.documentElement);
      window.Chargix = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }}
        },
        moneyFormat: {{ shop.money_format | json }},
        reducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)').matches
      };
    </script>
    <script src="{{ 'motion.js' | asset_url }}" defer></script>
    <script src="{{ 'cart.js' | asset_url }}" defer></script>
    {%- if settings.smooth_scroll -%}
      <script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
    {%- endif -%}
    <script src="{{ 'feed.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}" data-transitions="{{ settings.page_transitions }}" data-cursor="{{ settings.cursor_glow }}" data-smooth="{{ settings.smooth_scroll }}">
    <div class="bg-blobs" aria-hidden="true"><i></i><i></i><i></i></div>
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    <div class="charge-bar" aria-hidden="true"><span></span></div>
    <div class="swipe-cover" aria-hidden="true"><span class="swipe-cover__word">chargix</span></div>
    <script>
      (function (nav) {
        if (!nav || !nav.img) return;
        var img = document.createElement('img');
        img.className = 'arrive-img';
        img.alt = '';
        img.src = nav.img;
        document.body.appendChild(img);
      })(window.__cxNav);
    </script>

    {% sections 'header-group' %}

    <main id="MainContent" class="page" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}

    <div class="sticker-cursor" aria-hidden="true"><span></span></div>
  </body>
</html>
