<div class="drawer" data-cart-drawer hidden>
  <div class="drawer__scrim" data-cart-close></div>
  <aside class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle">
    <header class="drawer__head">
      <h2 id="CartDrawerTitle" class="drawer__title">{{ 'cart.title' | t }}</h2>
      <button class="header__icon" type="button" data-cart-close>{% render 'icon', icon: 'close' %}<span class="visually-hidden">{{ 'general.close' | t }}</span></button>
    </header>
    <div class="drawer__meter" data-ship-meter data-threshold="{{ settings.free_ship_threshold | times: 100 }}">
      <p class="drawer__meter-label" data-ship-label></p>
      <div class="meter"><span data-ship-fill></span></div>
    </div>
    <div class="drawer__body" data-cart-items aria-live="polite"></div>
    <footer class="drawer__foot">
      <div class="drawer__total"><span>{{ 'cart.subtotal' | t }}</span><strong data-cart-total>{{ cart.total_price | money }}</strong></div>
      <p class="drawer__note">{{ 'cart.taxes_note' | t }}</p>
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="btn btn--volt btn--block" data-magnetic>{{ 'cart.checkout' | t }} {% render 'icon', icon: 'lock' %}</button>
      </form>
    </footer>
  </aside>
</div>
