{%- comment -%}
  Categories as a bento board of colour blocks. Each tile shows a product from
  its collection that pops out of the tile and spins on hover; tiles fly in
  from scattered angles as the board scrolls into view.
{%- endcomment -%}
<section class="bento-sec section" data-bento>
  <div class="container section__head">
    <div>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="h2" data-bounce>{{ section.settings.heading }}</h2>
    </div>
    <a class="link-arrow" href="{{ routes.collections_url }}">{{ 'collections.all_categories' | t }} {% render 'icon', icon: 'arrow' %}</a>
  </div>
  <div class="container bento">
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      {%- if c == blank -%}{%- continue -%}{%- endif -%}
      {%- assign p = c.products.first -%}
      <a class="tile tile--{{ block.settings.color }} tile--n{{ forloop.index }}" href="{{ c.url }}" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <span class="tile__count">{{ c.products_count }} {{ 'collections.items' | t }}</span>
        <span class="tile__title">{{ block.settings.title | default: c.title | escape }}</span>
        <span class="tile__go" aria-hidden="true">{% render 'icon', icon: 'arrow' %}</span>
        {%- if p.featured_media -%}
          <span class="tile__img">{{ p.featured_media | image_url: width: 640 | image_tag: loading: 'lazy', alt: '' }}</span>
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Category bento",
  "class": "section-bento",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by vibe" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your next obsession" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        {
          "type": "select", "id": "color", "label": "Tile colour", "default": "pink",
          "options": [
            { "value": "pink", "label": "Hot pink" }, { "value": "lime", "label": "Lime" },
            { "value": "orange", "label": "Tangerine" }, { "value": "violet", "label": "Violet" },
            { "value": "mint", "label": "Mint" }, { "value": "ink", "label": "Ink" },
            { "value": "butter", "label": "Butter" }
          ]
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Category bento" }]
}
{% endschema %}
