<div class="announce" role="region" aria-label="{{ 'general.announcements' | t }}">
  <div class="announce__track" aria-hidden="false">
    {%- for i in (1..2) -%}
      <ul class="announce__list"{% if i == 2 %} aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <li class="announce__item" {{ block.shopify_attributes }}>
            {% render 'icon', icon: 'bolt' %}
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement ticker",
  "class": "section-announce",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping across the US" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement ticker",
      "blocks": [
        { "type": "message", "settings": { "text": "Free shipping across the US" } },
        { "type": "message", "settings": { "text": "30-day returns" } },
        { "type": "message", "settings": { "text": "Secure checkout" } }
      ]
    }
  ]
}
{% endschema %}
