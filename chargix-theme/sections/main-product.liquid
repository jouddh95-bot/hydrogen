{%- assign current = product.selected_or_first_available_variant -%}
{%- assign featured = current.featured_media | default: product.featured_media -%}
<section class="pdp" data-product data-section="{{ section.id }}">
  <div class="container pdp__grid">
    <div class="pdp__gallery">
      <div class="pdp__stage" data-tilt data-tilt-strength="6">
        <div class="pdp__stage-glow" aria-hidden="true"></div>
        <div class="pdp__main" data-shared-target>
          {%- if featured -%}
            {{ featured | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 55vw, 100vw', class: 'pdp__main-img', alt: product.title }}
          {%- endif -%}
        </div>
        <span class="card__glare" aria-hidden="true"></span>
      </div>
      {%- if product.media.size > 1 -%}
        <ul class="pdp__thumbs" aria-label="{{ 'products.gallery' | t }}">
          {%- for media in product.media -%}
            {%- if media.media_type != 'image' -%}{%- continue -%}{%- endif -%}
            <li>
              <button type="button" class="pdp__thumb{% if media.id == featured.id %} is-active{% endif %}" data-thumb data-media-id="{{ media.id }}" data-src="{{ media | image_url: width: 1400 }}" aria-label="{{ 'products.view_image' | t: number: forloop.index }}">
                {{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="pdp__info">
      <nav class="crumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
        <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
        {%- if collection -%}<span>/</span><a href="{{ collection.url }}">{{ collection.title | escape }}</a>{%- endif -%}
      </nav>
      <h1 class="pdp__title">{{ product.title | escape }}</h1>
      <div class="pdp__price" data-price-wrap>{% render 'price', product: product, variant: current %}</div>

      {%- form 'product', product, class: 'pdp__form', data-add-form: '', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <fieldset class="opt" data-option-index="{{ forloop.index0 }}">
              <legend class="opt__legend">{{ option.name | escape }}: <b data-option-label>{{ option.selected_value | escape }}</b></legend>
              <div class="opt__pills">
                {%- for value in option.values -%}
                  <label class="pill">
                    <input type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %} data-option-input>
                    <span>{{ value | escape }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}

        <div class="pdp__buy">
          <div class="qty" data-qty>
            <button type="button" data-qty-step="-1" aria-label="{{ 'products.decrease' | t }}">{% render 'icon', icon: 'minus' %}</button>
            <label for="Qty-{{ section.id }}" class="visually-hidden">{{ 'products.quantity' | t }}</label>
            <input id="Qty-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
            <button type="button" data-qty-step="1" aria-label="{{ 'products.increase' | t }}">{% render 'icon', icon: 'plus' %}</button>
          </div>
          <button type="submit" class="btn btn--volt btn--lg pdp__add" data-add-button data-magnetic{% unless current.available %} disabled{% endunless %}>
            <span data-add-label>{% if current.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>
            {% render 'icon', icon: 'bolt' %}
          </button>
        </div>
        {%- if section.settings.show_dynamic_checkout -%}
          <div class="pdp__dynamic">{{ form | payment_button }}</div>
        {%- endif -%}
      {%- endform -%}

      <ul class="pdp__perks">
        <li>{% render 'icon', icon: 'truck' %} {{ 'products.perk_shipping' | t }}</li>
        <li>{% render 'icon', icon: 'return' %} {{ 'products.perk_returns' | t }}</li>
        <li>{% render 'icon', icon: 'lock' %} {{ 'products.perk_secure' | t }}</li>
      </ul>

      <div class="pdp__desc rte">{{ product.description }}</div>
    </div>
  </div>

  <div class="sticky-buy" data-sticky-buy hidden>
    <div class="sticky-buy__info">
      {%- if featured -%}{{ featured | image_url: width: 120 | image_tag: alt: '' }}{%- endif -%}
      <div><b>{{ product.title | escape }}</b><span data-sticky-price>{{ current.price | money }}</span></div>
    </div>
    <button type="button" class="btn btn--volt" data-sticky-add>{{ 'products.add_to_cart' | t }}</button>
  </div>

  <script type="application/json" data-product-json>{{ product | json }}</script>
</section>

{% schema %}
{
  "name": "Product",
  "class": "section-main-product",
  "settings": [
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show Shop Pay / Buy now button", "default": true }
  ]
}
{% endschema %}
