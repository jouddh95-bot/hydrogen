<section class="grid-section section">
  <div class="container section__head">
    <div>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="h2" data-bounce>{{ section.settings.heading }}</h2>
    </div>
    {%- if section.settings.collection != blank -%}
      <a class="link-arrow" href="{{ section.settings.collection.url }}">{{ 'collections.view_all' | t }} {% render 'icon', icon: 'arrow' %}</a>
    {%- endif -%}
  </div>
  <div class="container product-grid">
    {%- for product in section.settings.collection.products limit: section.settings.limit -%}
      {% render 'product-card', product: product, index: forloop.index0 %}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Product grid",
  "class": "section-grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The full kit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "All gear" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 24, "step": 4, "default": 8 }
  ],
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}
