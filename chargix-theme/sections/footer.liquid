<footer class="footer"{% if settings.halloween_mode %} data-eyes="4"{% endif %}>
  <div class="footer__glow" aria-hidden="true"></div>
  <div class="container footer__grid">
    <div class="footer__brand">
      {% render 'logo', size: 'xl' %}
      <p class="footer__tagline">{{ section.settings.tagline }}</p>
      {%- if section.settings.show_newsletter -%}
        {%- form 'customer', class: 'newsletter', id: 'FooterNewsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label for="NewsletterEmail" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
          <input id="NewsletterEmail" type="email" name="contact[email]" required placeholder="{{ 'newsletter.placeholder' | t }}" autocomplete="email">
          <button type="submit" class="btn btn--volt">{{ 'newsletter.button' | t }}</button>
          {%- if form.posted_successfully? -%}<p class="newsletter__ok" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
          {%- if form.errors -%}<p class="newsletter__err" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        {%- endform -%}
      {%- endif -%}
    </div>
    {%- for block in section.blocks -%}
      <nav class="footer__col" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
        <h2 class="eyebrow">{{ block.settings.heading }}</h2>
        <ul>
          {%- for link in block.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endfor -%}
  </div>
  <div class="footer__mega" aria-hidden="true">chargix</div>
  <div class="container footer__base">
    <small>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</small>
    <ul class="footer__policies">
      {%- for policy in shop.policies -%}
        <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.show_payment_icons -%}
      <ul class="footer__pay" aria-label="{{ 'general.payment_methods' | t }}">
        {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'pay-icon' }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Gear that keeps you charged, mounted and shooting." },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
