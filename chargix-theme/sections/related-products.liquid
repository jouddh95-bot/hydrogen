<section class="rail section" data-rail>
  <div class="container section__head">
    <h2 class="h2 reveal">{{ section.settings.heading }}</h2>
    <div class="rail__actions">
      <button class="round-btn" type="button" data-rail-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', icon: 'arrow' %}</button>
      <button class="round-btn" type="button" data-rail-next aria-label="{{ 'general.next' | t }}">{% render 'icon', icon: 'arrow' %}</button>
    </div>
  </div>
  <div class="rail__track container" data-rail-track>
    {%- assign source = product.collections.first | default: collections.all -%}
    {%- assign shown = 0 -%}
    {%- for p in source.products -%}
      {%- if p.id == product.id -%}{%- continue -%}{%- endif -%}
      {% render 'product-card', product: p, index: shown %}
      {%- assign shown = shown | plus: 1 -%}
      {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    {%- if shown < 3 -%}
      {%- for p in collections.all.products -%}
        {%- if p.id == product.id -%}{%- continue -%}{%- endif -%}
        {%- if source.products contains p -%}{%- continue -%}{%- endif -%}
        {% render 'product-card', product: p, index: shown %}
        {%- assign shown = shown | plus: 1 -%}
        {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Related products",
  "class": "section-related",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the kit" },
    { "type": "range", "id": "limit", "label": "Products", "min": 3, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Related products" }]
}
{% endschema %}
