{%- comment -%}
  Categories as a coverflow deck: cards rotate in 3D depending on their
  distance from the centre of the scroller (motion.js > initDecks).
{%- endcomment -%}
<section class="deck section" data-deck>
  <div class="container section__head">
    <div>
      <p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>
      <h2 class="h2 reveal" style="--i:1">{{ section.settings.heading }}</h2>
    </div>
    <div class="deck__nav">
      <button class="round-btn" type="button" data-deck-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', icon: 'arrow' %}</button>
      <button class="round-btn" type="button" data-deck-next aria-label="{{ 'general.next' | t }}">{% render 'icon', icon: 'arrow' %}</button>
    </div>
  </div>
  <div class="deck__scroller" data-deck-scroller tabindex="0" aria-label="{{ section.settings.heading | escape }}">
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      {%- if c == blank -%}{%- continue -%}{%- endif -%}
      {%- liquid
        assign img = block.settings.image | default: c.image
        if img == blank
          assign img = c.products.first.featured_media
        endif
      -%}
      <a class="deck__card" href="{{ c.url }}" style="--hue: {{ block.settings.hue }}" data-deck-card {{ block.shopify_attributes }}>
        <div class="deck__media">
          {%- if img -%}
            {{ img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 30vw, 75vw', alt: c.title }}
          {%- endif -%}
        </div>
        <div class="deck__info">
          <span class="deck__count">{{ c.products_count }} {{ 'collections.items' | t }}</span>
          <h3 class="deck__title">{{ c.title | escape }}</h3>
          <span class="deck__cta">{{ 'collections.shop' | t }} {% render 'icon', icon: 'arrow' %}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Category deck",
  "class": "section-deck",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Categories" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick your power-up" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (optional)", "info": "Defaults to the collection image or its first product. Higgsfield renders look great here." },
        { "type": "range", "id": "hue", "label": "Glow hue", "min": 0, "max": 360, "step": 5, "default": 220 }
      ]
    }
  ],
  "presets": [{ "name": "Category deck" }]
}
{% endschema %}
