{%- comment -%}
  Home hero, "the feed": a colour-block stage with a giant bouncing headline
  and a phone that swipes through the store's viral picks like a short-video
  feed. Sticker cut-outs of products float around it and follow the pointer.
{%- endcomment -%}
{%- assign feed = section.settings.feed_collection -%}
<section class="fhero" data-fhero>
  <div class="fhero__stage">
    <div class="fhero__mesh" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <div class="fhero__grid">
      <div class="fhero__copy">
        <p class="fhero__live"><span class="fhero__dot"></span>{{ section.settings.eyebrow }}</p>
        <h1 class="fhero__title" data-bounce>{{ section.settings.heading }}</h1>
        <p class="fhero__sub">{{ section.settings.subheading }}</p>
        <div class="fhero__ctas">
          {%- if section.settings.cta_label != blank -%}
            <a class="btn btn--pop btn--lg" href="{{ section.settings.cta_link }}" data-magnetic>{{ section.settings.cta_label }} {% render 'icon', icon: 'arrow' %}</a>
          {%- endif -%}
          {%- if section.settings.cta2_label != blank -%}
            <a class="btn btn--line btn--lg" href="{{ section.settings.cta2_link }}" data-magnetic>{{ section.settings.cta2_label }}</a>
          {%- endif -%}
        </div>
        <ul class="fhero__chips">
          {%- for block in section.blocks -%}
            <li style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}><b>{{ block.settings.value }}</b> {{ block.settings.label }}</li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="fhero__phone-wrap" data-fhero-parallax>
        {%- for p in feed.products offset: 6 limit: 3 -%}
          <a class="fhero__sticker fhero__sticker--{{ forloop.index }}" href="{{ p.url }}" data-depth="{{ forloop.index | times: 0.6 | plus: 0.4 }}" aria-label="{{ p.title | escape }}" tabindex="-1">
            {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 360 | image_tag: loading: 'eager', alt: '' }}{%- endif -%}
          </a>
        {%- endfor -%}
        <span class="fhero__badge fhero__badge--a" data-depth="1.4">{% render 'icon', icon: 'sparkle' %} {{ section.settings.badge_a }}</span>
        <span class="fhero__badge fhero__badge--b" data-depth="0.8">{% render 'icon', icon: 'star' %} {{ section.settings.badge_b }}</span>

        <div class="phone" data-depth="0.25">
          <div class="phone__screen">
            <span class="phone__notch" aria-hidden="true"></span>
            <div class="phone__top" aria-hidden="true"><span>Following</span><b>For you</b></div>
            <ul class="phone__feed" data-feed>
              {%- for p in feed.products limit: 6 -%}
                {%- assign v = p.selected_or_first_available_variant -%}
                <li class="reel" style="--n: {{ forloop.index0 }}">
                  <a class="reel__link" href="{{ p.url }}" data-product-link>
                    <span class="reel__media" data-shared-media>
                      {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 700 | image_tag: loading: 'eager', class: 'reel__img', alt: p.title }}{%- endif -%}
                    </span>
                    <span class="reel__shade" aria-hidden="true"></span>
                    <span class="reel__meta">
                      <span class="reel__handle">@chargix</span>
                      <span class="reel__title">{{ p.title | escape | truncatewords: 7 }}</span>
                      <span class="reel__shop">{% render 'icon', icon: 'cart' %} {{ v.price | money }}{% if v.compare_at_price > v.price %} <s>{{ v.compare_at_price | money }}</s>{% endif %}</span>
                    </span>
                  </a>
                  <span class="reel__rail" aria-hidden="true">
                    <span class="reel__act reel__act--like">{% render 'icon', icon: 'heart' %}</span>
                    <span class="reel__act">{% render 'icon', icon: 'chat' %}</span>
                    <span class="reel__act">{% render 'icon', icon: 'share' %}</span>
                  </span>
                </li>
              {%- endfor -%}
            </ul>
            <span class="phone__progress" aria-hidden="true"><span></span></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feed hero",
  "class": "section-fhero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Live label", "default": "Trending right now" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tech that broke the internet." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "The gadgets you keep seeing on your feed, hand-picked, tested and shipped free across the US." },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "Shop the bestsellers" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button", "default": "Explore collections" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" },
    { "type": "collection", "id": "feed_collection", "label": "Products in the phone feed", "info": "The first 6 play in the phone, the next 3 float around it as stickers." },
    { "type": "text", "id": "badge_a", "label": "Floating badge 1", "default": "Seen on your feed" },
    { "type": "text", "id": "badge_b", "label": "Floating badge 2", "default": "Tested by us" }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Chip",
      "settings": [
        { "type": "text", "id": "value", "label": "Bold text", "default": "Free" },
        { "type": "text", "id": "label", "label": "Text", "default": "US shipping" }
      ]
    }
  ],
  "presets": [{ "name": "Feed hero" }]
}
{% endschema %}
