<section class="trust section section--tight">
  <ul class="container trust__list">
    {%- for block in section.blocks -%}
      <li class="trust__item reveal" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <span class="trust__icon">{% render 'icon', icon: block.settings.icon %}</span>
        <span><b>{{ block.settings.title }}</b><small>{{ block.settings.text }}</small></span>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Trust bar",
  "class": "section-trust",
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "truck", "label": "Truck" }, { "value": "return", "label": "Return" },
          { "value": "lock", "label": "Lock" }, { "value": "bolt", "label": "Bolt" }
        ], "default": "truck" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free US shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "On every order" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Trust bar" }]
}
{% endschema %}
