<section class="cats section">
  <div class="container">
    <p class="eyebrow">{{ 'collections.all_categories' | t }}</p>
    <h1 class="h1 cats__title" data-bounce>{{ section.settings.heading }}</h1>
  </div>
  <div class="container cats__grid">
    {%- assign hues = '330,25,275,165,300,45,5,85,350,190' | split: ',' -%}
    {%- for c in collections -%}
      {%- if c.handle == 'frontpage' or c.handle == 'products' or c.products_count == 0 -%}{%- continue -%}{%- endif -%}
      {%- assign img = c.image | default: c.products.first.featured_media -%}
      {%- assign h = forloop.index0 | modulo: 10 -%}
      <a class="cat-tile reveal" href="{{ c.url }}" style="--i: {{ forloop.index0 }}; --hue: {{ hues[h] }}" data-tilt>
        <div class="cat-tile__media">
          {%- if img -%}{{ img | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 33vw, 90vw', alt: c.title }}{%- endif -%}
        </div>
        <div class="cat-tile__body">
          <h2 class="cat-tile__title">{{ c.title | escape }}</h2>
          <span class="mono">{{ c.products_count }} {{ 'collections.items' | t }}</span>
        </div>
        <span class="card__glare" aria-hidden="true"></span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Category list",
  "class": "section-list-collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick your vibe" }
  ]
}
{% endschema %}
