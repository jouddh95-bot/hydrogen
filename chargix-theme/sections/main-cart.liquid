<section class="section cart-page">
  <div class="container">
    <h1 class="h1 reveal">{{ 'cart.title' | t }}</h1>
    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart-page__grid">
        <ul class="cart-lines">
          {%- for item in cart.items -%}
            <li class="line reveal" style="--i: {{ forloop.index0 }}">
              <a class="line__img" href="{{ item.url }}">{%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: alt: item.product.title }}{%- endif -%}</a>
              <div class="line__info">
                <a class="line__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                {%- unless item.product.has_only_default_variant -%}<span class="line__variant">{{ item.variant.title | escape }}</span>{%- endunless -%}
                <span class="line__price">{{ item.final_price | money }}</span>
              </div>
              <div class="line__qty">
                <label for="Updates-{{ item.key }}" class="visually-hidden">{{ 'products.quantity' | t }}</label>
                <input id="Updates-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
                <a href="{{ item.url_to_remove }}" class="line__remove">{{ 'cart.remove' | t }}</a>
              </div>
              <strong class="line__total">{{ item.final_line_price | money }}</strong>
            </li>
          {%- endfor -%}
        </ul>
        <aside class="cart-summary">
          <div class="drawer__total"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></div>
          <p class="drawer__note">{{ 'cart.taxes_note' | t }}</p>
          <button type="submit" name="update" class="btn btn--ghost btn--block">{{ 'cart.update' | t }}</button>
          <button type="submit" name="checkout" class="btn btn--volt btn--block btn--lg" data-magnetic>{{ 'cart.checkout' | t }} {% render 'icon', icon: 'lock' %}</button>
        </aside>
      </form>
    {%- else -%}
      <div class="empty empty--big">
        <div class="empty__battery" aria-hidden="true"><span></span></div>
        <p>{{ 'cart.empty' | t }}</p>
        <a class="btn btn--volt" href="{{ routes.all_products_collection_url }}" data-magnetic>{{ 'cart.continue' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart", "class": "section-main-cart" }
{% endschema %}
