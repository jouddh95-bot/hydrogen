<section class="page-shell section">
  <div class="container container--narrow">
    <p class="eyebrow reveal">{{ shop.name }}</p>
    <h1 class="h1 reveal" style="--i:1">{{ page.title | escape }}</h1>
    <div class="rte page-shell__body reveal" style="--i:2" data-faq>{{ page.content }}</div>
  </div>
</section>

{% schema %}
{ "name": "Page", "class": "section-main-page" }
{% endschema %}
